## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Build results
bin/
obj/
out/
build/
[Bb]uild/
[Dd]ebug/
[Rr]elease/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Logs
*.log

# SQL Server
*.mdf
*.ldf

# Entity Framework
Migrations/*.Designer.cs
Migrations/*.resx
Migrations/*Snapshot.cs

# Publish
publish/
*.pubxml
*.publishproj

# IIS Express
.vs/
iisexpress/

# Rider / VS Code (لو استخدمتيهم)
.idea/
.vscode/

# OS Files
Thumbs.db
Desktop.ini
.DS_Store

# NuGet
*.nupkg
packages/
!packages/build/
*.snupkg

# Environment files (لو عندك secrets)
appsettings.Development.json
.env

# Coverage / Test
TestResults/
coverage/
*.coverage
*.coveragexml

# Resharper
_ReSharper*/
*.DotSettings.user